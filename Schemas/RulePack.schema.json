{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.entraobjectinspector.local/rule-pack/1.0.0",
  "title": "Entra Object Inspector Rule Pack",
  "type": "object",
  "required": ["ContractName", "SchemaVersion", "RulePackId", "Rules"],
  "properties": {
    "ContractName": { "const": "EntraObjectInspector.RulePack" },
    "SchemaVersion": { "const": "1.0.0" },
    "RulePackId": { "type": "string", "minLength": 1 },
    "Rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["RuleId", "Category", "Title", "Description", "Severity", "WhyItMatters", "RecommendedAction", "Predicates"],
        "properties": {
          "RuleId": { "type": "string", "minLength": 1 },
          "Category": { "enum": ["IdentityGovernance", "Credentials", "Permissions", "ServicePrincipal", "Consent", "Users", "Groups"] },
          "Severity": { "enum": ["Informational", "Low", "Medium", "High"] },
          "Confidence": { "enum": ["High", "Medium", "Low"] },
          "SignalDisposition": { "enum": ["Actionable", "Review", "Contextual"] },
          "Predicates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["Path", "Operator"],
              "properties": {
                "Path": { "type": "string", "minLength": 1 },
                "Operator": { "enum": ["Equals", "NotEquals", "Contains", "In", "Exists"] }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
